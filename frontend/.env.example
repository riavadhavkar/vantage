# Backend base URL, including /api
VITE_VANTAGE_API_URL=http://localhost:8000/api
# 1 = use the SAMPLE mocks in src/mocks (no backend needed)
VITE_VANTAGE_USE_MOCKS=0
# 1 = play demo/demo_path.json with cached media and no network calls (same as ?demo=1)
VITE_VANTAGE_DEMO_MODE=0
# Topics offered on the landing page until GET /api/topic exists (comma separated)
VITE_VANTAGE_EXAMPLE_TOPICS=Titanic,Battle of Princeton
# Phone number for continuing a session over iMessage (shown with the session's link code)
VITE_VANTAGE_PHOTON_NUMBER=
